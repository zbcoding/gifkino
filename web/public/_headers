# connect-src: ffmpeg.wasm's ~30 MB core comes from an npm CDN on the first video
# import (unpkg if jsDelivr fails), checked against its expected SHA-256 before use.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' https://cdn.jsdelivr.net https://unpkg.com; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/images/*
  Cache-Control: public, max-age=86400

# The editor's build output is content-hashed: it never changes under one name.
/edit/assets/*
  Cache-Control: public, max-age=31536000, immutable
